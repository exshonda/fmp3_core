# -*- coding: utf-8 -*-
#
#		パス2の生成スクリプトのチップ依存部（ZynqMP RPU用）
#
#  $Id$
#

#
#  使用できる割込み番号とそれに対応する割込みハンドラ番号
#
$INTNO_VALID = {}
$INHNO_VALID = {}
$INTNO_GLOBAL = {}
$INHNO_GLOBAL = {}
private_intno_list = [ *(0..31) ]
global_intno_list = [ *(32..186) ]
1.upto($TNUM_PRCID) do |prcid|
  $INTNO_VALID[prcid] = []
  $INHNO_VALID[prcid] = []
  $INTNO_GLOBAL[prcid] = []
  $INHNO_GLOBAL[prcid] = []
  private_intno_list.each do |intno|
    $INTNO_VALID[prcid].push((prcid << 16) | intno)
    $INHNO_VALID[prcid].push((prcid << 16) | intno)
    $INTNO_GLOBAL[prcid][intno] = (prcid << 16) | intno
    $INHNO_GLOBAL[prcid][intno] = (prcid << 16) | intno
  end
  global_intno_list.each do |intno|
    $INTNO_VALID[prcid].push(intno)
    $INHNO_VALID[prcid].push((prcid << 16) | intno)
    $INTNO_GLOBAL[prcid][intno] = intno
    $INHNO_GLOBAL[prcid][intno] = (prcid << 16) | intno
  end
end

#
#  生成スクリプトのコア依存部
#
IncludeTrb("core_kernel.trb")
