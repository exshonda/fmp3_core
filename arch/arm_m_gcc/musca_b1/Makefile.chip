#
#		Makefile のチップ依存部（Musca-B1 / Cortex-M33 用）
#

#
#  チップ依存部ディレクトリ名の定義
#
CHIPDIR = $(SRCDIR)/arch/$(CORE)_$(TOOL)/$(CHIP)

#
#  コンパイルオプション
#
#  Cortex-M33（ARMv8-M Mainline），Thumb 命令のみ．Musca-B1 の M33 は FPU/DSP
#  を搭載するが，ソフトウェア浮動小数点 ABI を用いる．
#
COPTS := $(COPTS) -mcpu=cortex-m33 -mthumb -mfloat-abi=soft
LDFLAGS := $(LDFLAGS) -mcpu=cortex-m33 -mthumb -mfloat-abi=soft
CDEFS := $(CDEFS) -DTOPPERS_CORTEX_M33

#
#  ARMアーキテクチャの世代（ARMv8-M Mainline）
#
#  __TARGET_ARCH_THUMB は旧 ARM 純正コンパイラの組込みマクロであり，GNU
#  開発環境では定義されないため，明示的に定義する（5 = ARMv8-M）．
#
CDEFS := $(CDEFS) -D__TARGET_ARCH_THUMB=5

#
#  TrustZone 対応コアでのセキュア単独動作
#
#  QEMU musca-b1 (Cortex-M33) はリセット直後セキュア状態で動作する．
#  TrustZone 搭載コアでは，例外リターン値 EXC_RETURN にセキュア状態を
#  表すビットが必要なため，TOPPERS_ENABLE_TRUSTZONE を定義してセキュア
#  用の EXC_RETURN (0xfffffffd) を選択する．これを定義しないと，非セキュア
#  用の 0xffffffbc が用いられ，セキュア状態からの例外リターン整合性チェック
#  に失敗する．
#
CDEFS := $(CDEFS) -DTOPPERS_ENABLE_TRUSTZONE

INCLUDES := $(INCLUDES) -I$(CHIPDIR)

#
#  カーネルに関する定義
#
KERNEL_DIRS := $(KERNEL_DIRS) $(CHIPDIR)
KERNEL_COBJS := $(KERNEL_COBJS) chip_kernel_impl.o

#
#  システムサービスに関する定義
#
SYSSVC_DIRS := $(SYSSVC_DIRS) $(CHIPDIR)

#
#  スタートアップモジュールに関する定義
#
#  START_OBJSをstart.oに設定し，LDFLAGSに-nostdlibを追加する．
#
START_OBJS := start.o $(START_OBJS)
START_OBJS := $(addprefix $(OBJDIR)/, $(START_OBJS))

$(START_OBJS): $(OBJDIR)/%.o: %.S
	$(CC) -c -o $@ -MD -MP -MF $(DEPDIR)/$*.d $(CFLAGS) $(KERNEL_CFLAGS) $<

LDFLAGS := -nostdlib $(LDFLAGS)

#
#  コア依存部
#
include $(SRCDIR)/arch/$(CORE)_$(TOOL)/common/Makefile.core
