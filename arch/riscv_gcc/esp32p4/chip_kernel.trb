# -*- coding: utf-8 -*-
# 
#    パス2の生成スクリプトのチップ依存部（ESP32-P4 用）
# 

#
#  使用できる割込み番号とそれに対応する割込みハンドラ番号
#
$INTNO_VALID = {}
$INHNO_VALID = {}
#  CLIC 線番号 0..47（CLIC_TNUM_INTNO=48 に対応）
$clic_intno_list = [ *(0..47) ]
1.upto($TNUM_PRCID) do |prcid|
  $INTNO_VALID[prcid] = []
  $INHNO_VALID[prcid] = []
  $clic_intno_list.each do |intno|
    $INTNO_VALID[prcid].push(intno)
    $INHNO_VALID[prcid].push((prcid << 16) | intno)
  end
end

#
#  プロセッサID(1オリジン)からコンテキストINDEXへの変換
#    ESP32-P4: cidx = mhartid = prcid - 1（master=0）
#
def pid2cidx(pid)
  return (pid - 1)
end

#
#  生成スクリプトのコア依存部
#
IncludeTrb("core_kernel.trb")

#
#  生成スクリプトのCLIC依存部
#
IncludeTrb("clic_kernel.trb")
