# -*- coding: utf-8 -*-
#
#		パス2の生成スクリプトのターゲット依存部（RP2350 / RaspberryPi Pico 2用）
#
#  ARM-M のベクタテーブル・例外/割込みハンドラテーブル・割込み属性ビット
#  パターンを生成する．ASP3 の core_kernel.py（静的ベクタテーブル）を，FMP3
#  のプロセッサ単位（per-PRC）の構成へ拡張したものである．本ターゲットは
#  最大 2 プロセッサ（TNUM_PRCID=1 または 2）．
#

#
#  有効な割込み番号，割込みハンドラ番号
#  例外番号 15（SysTick）以降が割込みである．
#
$INHNO_VALID = {}
$INTNO_VALID = {}
1.upto($TNUM_PRCID) do |prcid|
  $INHNO_VALID[prcid] = []
  $INTNO_VALID[prcid] = []
  15.upto($TMAX_INTNO) do |intno|
    $INHNO_VALID[prcid].push((prcid << 16) | intno)
    $INTNO_VALID[prcid].push((prcid << 16) | intno)
  end
end

#
#  有効なCPU例外番号
#  2:NMI, 3:HardFault, 4:MemManage, 5:BusFault, 6:UsageFault, 12:DebugMonitor
#
$EXCNO_VALID = {}
excno_list = [2, 3, 4, 5, 6, 12]
1.upto($TNUM_PRCID) do |prcid|
  $EXCNO_VALID[prcid] = []
  excno_list.each do |excno|
    $EXCNO_VALID[prcid].push((prcid << 16) | excno)
  end
end

#
#  CRE_ISRで使用できる割込み番号とそれに対応する割込みハンドラ番号
#
$INTNO_CREISR_VALID = $INTNO_VALID
$INHNO_CREISR_VALID = $INHNO_VALID

#
#  DEF_INH／DEF_EXCで使用できる割込みハンドラ番号／CPU例外ハンドラ番号
#
$INHNO_DEFINH_VALID = $INHNO_VALID
$EXCNO_DEFEXC_VALID = $EXCNO_VALID

#
#  CFG_INTで使用できる割込み番号と割込み優先度
#  最大優先度はBASEPRIレジスタでマスクできない優先度（内部優先度'0'）．
#  そのため，カーネル管理外の割込みでのみ指定可能．
#
$INTNO_CFGINT_VALID = $INTNO_VALID
$INTPRI_CFGINT_VALID = (-(1 << $TBITW_IPRI)..-1).to_a

#
#  生成スクリプトのチップ依存部（チップ→コア→kernel.trb）
#
IncludeTrb("chip_kernel.trb")

#
#  ターゲット依存の定義
#
$kernelCfgC.append(<<EOS)
/*
 *  Target-dependent Definitions (ARM-M / Musca-B1)
 */
EOS

#
#  ベクタテーブル（プロセッサ単位）と例外/割込みハンドラテーブル
#
1.upto($TNUM_PRCID) do |prcid|
  #
  #  ベクタテーブル
  #
  #  ARMv8-M の VTOR は，ベクタテーブルのエントリ数を格納できる最小の
  #  2 のべき乗のサイズ境界にアライメントされていなければならない．
  #  TMAX_INTNO+1 エントリ（各 4byte）を格納できる境界を求めて指定する．
  #  プロセッサ単位にテーブルを並べると 2 番目以降が境界を割るため，全
  #  テーブルに明示的なアライメントを与える（単一プロセッサでは無害）．
  #
  vecttbl_bytes = ($TMAX_INTNO + 1) * 4
  vecttbl_align = 32
  while vecttbl_align < vecttbl_bytes
    vecttbl_align <<= 1
  end
  $kernelCfgC.add("__attribute__ ((section(\".vector\"),aligned(#{vecttbl_align})))")
  $kernelCfgC.add("const FP _kernel_vector_table_prc#{prcid}[] = {")
  $kernelCfgC.add("\t(FP)(TOPPERS_ISTKPT(_kernel_istack_prc#{prcid}, " \
                  "ROUND_STK_T(DEFAULT_ISTKSZ))),   /* 0 initial SP */")
  $kernelCfgC.add("\t(FP)_kernel_start,                 /* 1 reset handler */")
  2.upto(14) do |excno|
    case excno
    when 8, 9, 10, 13
      $kernelCfgC.add("\t(FP)(#{GenResVectVal(excno)}),")
    when 11
      $kernelCfgC.add("\t(FP)(_kernel_svc_handler),       /* 11 SVCall handler */")
    when 14
      $kernelCfgC.add("\t(FP)(_kernel_pendsv_handler),    /* 14 PendSV handler */")
    else
      excnoVal = (prcid << 16) | excno
      if $cfgData[:DEF_EXC].has_key?(excnoVal) &&
         ($cfgData[:DEF_EXC][excnoVal][:excatr] & $TA_DIRECT) != 0
        $kernelCfgC.add("\t(FP)(#{$cfgData[:DEF_EXC][excnoVal][:exchdr]}), /* #{excno} */")
      else
        $kernelCfgC.add("\t(FP)(_kernel_core_exc_entry), /* #{excno} */")
      end
    end
  end
  $INHNO_VALID[prcid].each do |inhnoVal|
    intno = inhnoVal & 0xffff
    if $cfgData[:DEF_INH].has_key?(inhnoVal) &&
       ($cfgData[:DEF_INH][inhnoVal][:inhatr] & $TA_NONKERNEL) != 0
      $kernelCfgC.add("\t(FP)(#{$cfgData[:DEF_INH][inhnoVal][:inthdr]}), /* #{intno} */")
    else
      $kernelCfgC.add("\t(FP)(_kernel_core_int_entry), /* #{intno} */")
    end
  end
  $kernelCfgC.add2("};")

  #
  #  例外/割込みハンドラテーブル（例外番号 0〜14 ＋ 割込み）
  #
  $kernelCfgC.add("const FP _kernel_exc_tbl_prc#{prcid}[] = {")
  0.upto(14) do |excno|
    excnoVal = (prcid << 16) | excno
    if $cfgData[:DEF_EXC].has_key?(excnoVal)
      $kernelCfgC.add("\t(FP)(#{$cfgData[:DEF_EXC][excnoVal][:exchdr]}), /* #{excno} */")
    else
      $kernelCfgC.add("\t(FP)(_kernel_default_exc_handler), /* #{excno} */")
    end
  end
  $INHNO_VALID[prcid].each do |inhnoVal|
    intno = inhnoVal & 0xffff
    if $cfgData[:DEF_INH].has_key?(inhnoVal)
      $kernelCfgC.add("\t(FP)(#{$cfgData[:DEF_INH][inhnoVal][:inthdr]}), /* #{intno} */")
    else
      $kernelCfgC.add("\t(FP)(_kernel_default_int_handler), /* #{intno} */")
    end
  end
  $kernelCfgC.add2("};")
end

#
#  ベクタテーブルのポインタテーブル（core_initialize が参照）
#
$kernelCfgC.add("const FP* const _kernel_p_vector_table[TNUM_PRCID] = {")
1.upto($TNUM_PRCID) do |prcid|
  $kernelCfgC.add(",") if prcid > 1
  $kernelCfgC.append("\t_kernel_vector_table_prc#{prcid}")
end
$kernelCfgC.add
$kernelCfgC.add2("};")

#
#  例外/割込みハンドラテーブルのポインタテーブル（core_int_entry が参照）
#
$kernelCfgC.add("const FP* const _kernel_p_exc_tbl[TNUM_PRCID] = {")
1.upto($TNUM_PRCID) do |prcid|
  $kernelCfgC.add(",") if prcid > 1
  $kernelCfgC.append("\t_kernel_exc_tbl_prc#{prcid}")
end
$kernelCfgC.add
$kernelCfgC.add2("};")

#
#  割込み属性が設定されているかを示すビットパターン（check_intno_cfg が参照）
#
if ($TMAX_INTNO & 0x0f) == 0x00
  bitpat_cfgint_num = ($TMAX_INTNO >> 4)
else
  bitpat_cfgint_num = ($TMAX_INTNO >> 4) + 1
end

1.upto($TNUM_PRCID) do |prcid|
  $kernelCfgC.add("const uint32_t _kernel_bitpat_cfgint_prc#{prcid}[#{bitpat_cfgint_num}] = {")
  0.upto(bitpat_cfgint_num - 1) do |num|
    bitpat = 0
    (num * 32).upto(num * 32 + 31) do |intno|
      intnoVal = (prcid << 16) | intno
      if $cfgData[:DEF_INH].has_key?(intnoVal)
        bitpat |= (1 << (intno & 0x1f))
      end
    end
    $kernelCfgC.add("\tUINT32_C(0x#{sprintf("%08x", bitpat)}),")
  end
  $kernelCfgC.add2("};")
end

$kernelCfgC.add("const uint32_t *_kernel_p_bitpat_cfgint[TNUM_PRCID] = {")
1.upto($TNUM_PRCID) do |prcid|
  $kernelCfgC.add(",") if prcid > 1
  $kernelCfgC.append("\t_kernel_bitpat_cfgint_prc#{prcid}")
end
$kernelCfgC.add
$kernelCfgC.add2("};")
